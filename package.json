{
  "name": "at-mapper-extension",
  "version": "1.0.0",
  "description": "Cross-browser @-mapping autocomplete for any editable field. Per-site enable/disable, export/import mappings.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "make-icons": "node scripts/make-icons.mjs",
    "copy-static": "node scripts/copy-static.mjs",
    "compile": "tsc",
    "build": "bun run clean && bun run make-icons && bun run compile && bun run copy-static",
    "build:firefox": "bun run clean && bun run make-icons && bun run compile && node scripts/copy-static.mjs --target=firefox",
    "package:chrome": "bun run build && node scripts/package.mjs --target=chrome",
    "package:firefox": "bun run build:firefox && node scripts/package.mjs --target=firefox",
    "test": "bun run build && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "make-store": "node scripts/capture-store-assets.mjs",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.287",
    "@types/firefox-webext-browser": "^120.0.4",
    "eslint": "^10.8.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0"
  }
}
